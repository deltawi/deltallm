# Used by `docker compose` automatically.
DELTALLM_MASTER_KEY=sk-change-me
DELTALLM_SALT_KEY=change-me
OPENAI_API_KEY=
# Optional direct chat providers, resolved by os.environ references in deployments.
DEEPSEEK_API_KEY=
ZAI_API_KEY=
DASHSCOPE_API_KEY=
TENCENT_API_KEY=
MINIMAX_API_KEY=

# Recommended if you want an initial admin account for the UI.
PLATFORM_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
PLATFORM_BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!

# Optional feature-specific settings.
LAKERA_API_KEY=
DELTALLM_S3_BUCKET=
REDIS_PASSWORD=

# Durable telemetry (startup settings; apply migrations before enabling outbox mode).
# DELTALLM_TELEMETRY_DB_POOL_SIZE=5
# DELTALLM_TELEMETRY_DB_POOL_TIMEOUT_SECONDS=2
# DELTALLM_TELEMETRY_WORKER_STARTUP_TIMEOUT_SECONDS=5
# DELTALLM_TELEMETRY_SHUTDOWN_DRAIN_TIMEOUT_SECONDS=20
# DELTALLM_SPEND_INGESTION_MODE=outbox
# DELTALLM_SPEND_INGESTION_WORKER_ENABLED=true
# DELTALLM_SPEND_INGESTION_MAX_PENDING_EVENTS=100000
# DELTALLM_SPEND_INGESTION_OVERLOAD_POLICY=sync_fallback
# DELTALLM_SPEND_INGESTION_FALLBACK_MAX_CONCURRENCY=1
# DELTALLM_SPEND_INGESTION_FALLBACK_MAX_WAITERS=8
# DELTALLM_SPEND_INGESTION_FALLBACK_QUEUE_TIMEOUT_MS=100
# DELTALLM_SPEND_INGESTION_FALLBACK_EXECUTION_TIMEOUT_SECONDS=2
# DELTALLM_AUDIT_INGESTION_MODE=outbox
# DELTALLM_AUDIT_INGESTION_WORKER_ENABLED=true
# DELTALLM_AUDIT_INGESTION_MAX_PENDING_EVENTS=100000
# DELTALLM_AUDIT_INGESTION_REQUIRED_RESERVE=10000

# Provider discovery egress is configured through startup-only general_settings
# provider_discovery_allow_http / allowed_ports / allowed_private_cidrs in YAML.
# These settings are independent of tenant batch webhook allowances.

# Finite Redis allocations, startup only; bulk may target a separate cache server.
# DELTALLM_REDIS_BULK_URL=redis://cache-host:6379/0
# DELTALLM_REDIS_CRITICAL_MAX_CONNECTIONS=64
# DELTALLM_REDIS_BULK_MAX_CONNECTIONS=16
# DELTALLM_REDIS_ACQUISITION_TIMEOUT_SECONDS=0.2
# DELTALLM_REDIS_SOCKET_TIMEOUT_SECONDS=1.0
# DELTALLM_REDIS_CONNECT_TIMEOUT_SECONDS=1.0

# Startup-only database and ordinary-cache allocations
DELTALLM_DB_FOREGROUND_POOL_SIZE=8
DELTALLM_TELEMETRY_WORKER_DB_POOL_SIZE=5
DELTALLM_DB_ACQUISITION_TIMEOUT_SECONDS=0.2
DELTALLM_DB_STATEMENT_TIMEOUT_SECONDS=1.0
DELTALLM_DB_LOCK_TIMEOUT_SECONDS=0.2
DELTALLM_DB_TRANSACTION_TIMEOUT_SECONDS=2.0
DELTALLM_DB_BACKGROUND_STATEMENT_TIMEOUT_SECONDS=5.0
DELTALLM_DB_BACKGROUND_LOCK_TIMEOUT_SECONDS=1.0
DELTALLM_DB_BACKGROUND_TRANSACTION_TIMEOUT_SECONDS=10.0
DELTALLM_REDIS_CACHE_MAX_CONNECTIONS=16

# Per-process ingress admission (startup only; explicit YAML/DB values take precedence).
# DELTALLM_GATEWAY_INGRESS_ENABLED=false
# DELTALLM_GATEWAY_INGRESS_MAX_ACTIVE=100
# DELTALLM_GATEWAY_INGRESS_MAX_WAITERS=0
# DELTALLM_GATEWAY_INGRESS_QUEUE_TIMEOUT_MS=10
# DELTALLM_GATEWAY_INGRESS_MAX_BODY_BYTES=33554432
# DELTALLM_GATEWAY_INGRESS_MAX_BUFFERED_BYTES=67108864
# DELTALLM_GATEWAY_INGRESS_BODY_TIMEOUT_SECONDS=10.0
# DELTALLM_GATEWAY_INGRESS_HEALTH_MAX_ACTIVE=4

# Reserved control ingress and bounded authentication fallback (startup only).
# DELTALLM_GATEWAY_INGRESS_CONTROL_MAX_ACTIVE=16
# DELTALLM_GATEWAY_INGRESS_CONTROL_MAX_BUFFERED_BYTES=67108864
# DELTALLM_AUTH_FALLBACK_MAX_ACTIVE=8
# DELTALLM_AUTH_FALLBACK_MAX_WAITERS=32
# DELTALLM_AUTH_FALLBACK_QUEUE_TIMEOUT_MS=10
# DELTALLM_AUTH_FALLBACK_TIMEOUT_SECONDS=0.5
# DELTALLM_AUTH_FALLBACK_CACHE_TIMEOUT_SECONDS=0.1
# DELTALLM_AUTH_FALLBACK_CACHE_MAX_BYTES=131072

# Combined budget reads (explicit YAML/DB settings take precedence).
# DELTALLM_BUDGET_ENFORCEMENT_QUERY_MODE=combined
# DELTALLM_BUDGET_ENFORCEMENT_QUERY_TIMEOUT_SECONDS=2
# Budget notification activation and silence TTL are startup-only YAML settings.
# See docs/deployment/budget-prompt-performance.md before enabling team/model budgets.

# Startup-only ordinary inference recovery; enable after migration and binary rollout.
# Requires spend outbox and worker. Settlement is carved from telemetry DB capacity.
DELTALLM_SPEND_OPERATION_INTENTS_ENABLED=false
DELTALLM_SPEND_SETTLEMENT_DB_POOL_SIZE=1

# Startup-only callback and guardrail work allocations (per API process).
DELTALLM_CALLBACK_MAX_PENDING=128
DELTALLM_CALLBACK_MAX_CONCURRENCY=4
DELTALLM_CALLBACK_MAX_PAYLOAD_BYTES=262144
DELTALLM_CALLBACK_MAX_BYTES=8388608
DELTALLM_CALLBACK_TIMEOUT_SECONDS=5
DELTALLM_CALLBACK_SHUTDOWN_SECONDS=5
DELTALLM_GUARDRAIL_MAX_CONCURRENCY=2
DELTALLM_GUARDRAIL_MAX_PENDING=8
DELTALLM_GUARDRAIL_MAX_BYTES=33554432
DELTALLM_GUARDRAIL_TIMEOUT_SECONDS=5
DELTALLM_GUARDRAIL_SHUTDOWN_SECONDS=5

# Managed process lifecycle. Explicit file values take precedence for these fields.
DELTALLM_READINESS_PROBE_TIMEOUT_SECONDS=1
DELTALLM_READINESS_CACHE_SECONDS=1
DELTALLM_LIFECYCLE_WITHDRAWAL_SECONDS=5
DELTALLM_LIFECYCLE_REQUEST_DRAIN_SECONDS=45
DELTALLM_LIFECYCLE_CANCELLATION_SECONDS=5
DELTALLM_LIFECYCLE_WORKER_DRAIN_SECONDS=20
DELTALLM_LIFECYCLE_CLOSE_SECONDS=5
DELTALLM_LIFECYCLE_SHUTDOWN_SECONDS=80
DELTALLM_MIGRATION_MODE=startup
DELTALLM_MIGRATION_VERIFY_TIMEOUT_SECONDS=10

# Startup-only Helm capacity contract; unset for standalone development.
# DELTALLM_DEPLOYMENT_CAPACITY_PATH=/app/capacity/report.json
DELTALLM_DEPLOYMENT_CAPACITY_ROLE=api
