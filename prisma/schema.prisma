generator client {
  provider                    = "prisma-client-py"
  interface                   = "asyncio"
  recursive_type_depth        = -1
  enable_experimental_decimal = true
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DeltaLLM_SpendLogEvents {
  id                     String   @id @default(uuid())
  request_id             String
  call_type              String
  api_key                String
  user_id                String?
  team_id                String?
  organization_id        String?
  owner_account_id       String?
  end_user_id            String?
  model                  String
  deployment_model       String?
  provider               String?
  api_base               String?
  spend                  Float
  provider_cost          Float?
  spend_exact            Decimal? @db.Decimal(38, 18)
  provider_cost_exact    Decimal? @db.Decimal(38, 18)
  billing_unit           String?
  pricing_tier           String?
  total_tokens           Int      @default(0)
  input_tokens           Int      @default(0)
  output_tokens          Int      @default(0)
  cached_input_tokens    Int      @default(0)
  cached_output_tokens   Int      @default(0)
  input_audio_tokens     Int      @default(0)
  output_audio_tokens    Int      @default(0)
  input_characters       Int      @default(0)
  output_characters      Int      @default(0)
  duration_seconds       Float    @default(0)
  image_count            Int      @default(0)
  rerank_units           Int      @default(0)
  start_time             DateTime
  end_time               DateTime
  latency_ms             Int?
  cache_hit              Boolean  @default(false)
  cache_key              String?
  request_tags           String[]
  unpriced_reason        String?
  pricing_fields_used    Json?
  usage_snapshot         Json?
  metadata               Json?
  status                 String   @default("success")
  http_status_code       Int?
  error_type             String?

  @@index([organization_id, start_time, id], map: "deltallm_spendlog_events_org_time_id_idx")
  @@index([owner_account_id, start_time, id], map: "deltallm_spendlog_events_owner_time_id_idx")
  @@index([team_id, start_time], map: "deltallm_spendlog_events_team_time_idx")
  @@index([api_key, start_time], map: "deltallm_spendlog_events_api_key_time_idx")
  @@index([user_id, start_time], map: "deltallm_spendlog_events_user_time_idx")
  @@index([model, start_time], map: "deltallm_spendlog_events_model_time_idx")
  @@index([provider, start_time], map: "deltallm_spendlog_events_provider_time_idx")
  @@index([start_time, id], map: "deltallm_spendlog_events_time_id_idx")
  @@index([request_tags], type: Gin, map: "deltallm_spendlog_events_request_tags_gin_idx")
  @@map("deltallm_spendlog_events")
}

model DeltaLLM_AccountingUsageFactV2 {
  event_id                  String   @id(map: "deltallm_accounting_usage_facts_v2_pkey")
  accounting_sequence       BigInt   @unique(map: "deltallm_usage_facts_v2_sequence_key")
  protocol_generation       BigInt
  source_sha256             Bytes
  operation_id              String
  request_id                String
  call_type                 String
  api_key                   String
  user_id                   String?
  team_id                   String?
  organization_id           String?
  owner_account_id          String?
  end_user_id               String?
  model                     String
  deployment_model          String?
  provider                  String?
  api_base                  String?
  spend                     Float
  provider_cost             Float?
  spend_exact               Decimal  @db.Decimal(38, 18)
  provider_cost_exact       Decimal? @db.Decimal(38, 18)
  billing_unit              String?
  pricing_tier              String?
  total_tokens              Int      @default(0)
  input_tokens              Int      @default(0)
  output_tokens             Int      @default(0)
  cached_input_tokens       Int      @default(0)
  cached_output_tokens      Int      @default(0)
  input_audio_tokens        Int      @default(0)
  output_audio_tokens       Int      @default(0)
  input_characters          Int      @default(0)
  output_characters         Int      @default(0)
  duration_seconds          Float    @default(0)
  image_count               Int      @default(0)
  rerank_units              Int      @default(0)
  start_time                DateTime @db.Timestamptz(6)
  end_time                  DateTime @db.Timestamptz(6)
  latency_ms                Int?
  cache_hit                 Boolean  @default(false)
  cache_key                 String?
  request_tags              String[]
  unpriced_reason           String?
  pricing_fields_used       Json?
  usage_snapshot            Json?
  metadata                  Json?
  status                    String   @default("success")
  http_status_code          Int?
  error_type                String?
  source_occurred_at        DateTime @db.Timestamptz(6)
  projected_at              DateTime @default(now()) @db.Timestamptz(6)

  @@index([organization_id, start_time, event_id], map: "deltallm_usage_facts_v2_org_time_id_idx")
  @@index([owner_account_id, start_time, event_id], map: "deltallm_usage_facts_v2_owner_time_id_idx")
  @@index([team_id, start_time, event_id], map: "deltallm_usage_facts_v2_team_time_id_idx")
  @@index([api_key, start_time, event_id], map: "deltallm_usage_facts_v2_api_key_time_id_idx")
  @@index([user_id, start_time, event_id], map: "deltallm_usage_facts_v2_user_time_id_idx")
  @@index([model, start_time, event_id], map: "deltallm_usage_facts_v2_model_time_id_idx")
  @@index([provider, start_time, event_id], map: "deltallm_usage_facts_v2_provider_time_id_idx")
  @@index([start_time, event_id], map: "deltallm_usage_facts_v2_time_id_idx")
  @@index([request_tags], type: Gin, map: "deltallm_usage_facts_v2_request_tags_gin_idx")
  @@map("deltallm_accounting_usage_facts_v2")
}

model DeltaLLM_AccountingUsageRollupV2 {
  bucket_kind              String
  bucket_start             DateTime @db.Timestamptz(6)
  organization_id          String   @default("")
  team_id                  String   @default("")
  user_id                  String   @default("")
  owner_account_id         String   @default("")
  api_key                  String   @default("")
  model                    String   @default("")
  provider                 String   @default("")
  status                   String   @default("success")
  rollup_shard             Int      @default(0) @db.SmallInt
  request_count            BigInt   @default(0)
  spend_exact              Decimal  @default(0) @db.Decimal(38, 18)
  provider_cost_exact      Decimal  @default(0) @db.Decimal(38, 18)
  total_tokens             BigInt   @default(0)
  input_tokens             BigInt   @default(0)
  output_tokens            BigInt   @default(0)
  cached_input_tokens      BigInt   @default(0)
  cached_output_tokens     BigInt   @default(0)
  updated_at               DateTime @default(now()) @db.Timestamptz(6)

  @@id([bucket_kind, bucket_start, organization_id, team_id, user_id, owner_account_id, api_key, model, provider, status, rollup_shard], map: "deltallm_usage_rollups_v2_pkey")
  @@index([organization_id, bucket_kind, bucket_start], map: "deltallm_usage_rollups_v2_org_bucket_idx")
  @@index([team_id, bucket_kind, bucket_start], map: "deltallm_usage_rollups_v2_team_bucket_idx")
  @@index([owner_account_id, bucket_kind, bucket_start], map: "deltallm_usage_rollups_v2_owner_bucket_idx")
  @@map("deltallm_accounting_usage_rollups_v2")
}

model DeltaLLM_TeamModelSpendCounter {
  team_id     String
  model       String
  spend       Float    @default(0)
  spend_exact Decimal? @db.Decimal(38, 18)
  reserved_spend_exact Decimal @default(0) @db.Decimal(38, 18)
  updated_at  DateTime @updatedAt
  reconciled_at DateTime?

  @@id([team_id, model])
  @@index([team_id], map: "deltallm_teammodelspend_team_idx")
  @@map("deltallm_teammodelspend")
}

model DeltaLLM_BudgetNotification {
  organization DeltaLLM_OrganizationTable @relation(fields: [organization_id], references: [organization_id], onDelete: Cascade)
  organization_id String @id
  notification_id String @unique
  spend Decimal @db.Decimal(38, 18)
  soft_budget Decimal @db.Decimal(38, 18)
  hard_budget Decimal? @db.Decimal(38, 18)
  status String @default("pending")
  attempt_count Int @default(0)
  available_at DateTime @default(now()) @db.Timestamptz(6)
  dedupe_until DateTime @db.Timestamptz(6)
  claim_token String?
  lease_expires_at DateTime? @db.Timestamptz(6)
  outcome String?
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("deltallm_budgetnotification")
}

model DeltaLLM_VerificationToken {
  id                    String   @id @default(uuid())
  token                 String   @unique
  key_name              String?
  user_id               String?
  team_id               String?
  owner_account_id      String?
  owner_service_account_id String?
  models                String[]
  max_budget            Float?
  soft_budget           Float?
  spend                 Float    @default(0)
  spend_exact           Decimal? @db.Decimal(38, 18)
  reserved_spend_exact Decimal @default(0) @db.Decimal(38, 18)
  budget_duration       String?
  budget_reset_at       DateTime?
  rpm_limit             Int?
  tpm_limit             Int?
  output_tpm_limit Int?
  model_output_tpm_limit Json?
  rph_limit             Int?
  rpd_limit             Int?
  tpd_limit             Int?
  max_parallel_requests Int?
  expires               DateTime?
  permissions           Json?
  metadata              Json?
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  user       DeltaLLM_UserTable? @relation(fields: [user_id], references: [user_id])
  team       DeltaLLM_TeamTable? @relation(fields: [team_id], references: [team_id])
  owner_account DeltaLLM_PlatformAccount? @relation("verificationtoken_account_owner", fields: [owner_account_id], references: [account_id])
  owner_service_account DeltaLLM_ServiceAccount? @relation("verificationtoken_service_account_owner", fields: [owner_service_account_id], references: [service_account_id])
  @@index([token])
  @@index([user_id])
  @@index([team_id])
  @@index([owner_account_id])
  @@index([owner_service_account_id])
  @@index([expires])
  @@map("deltallm_verificationtoken")
}

model DeltaLLM_UserTable {
  user_id         String   @id
  user_email      String?  @unique
  user_role       String   @default("internal_user")
  max_budget      Float?
  soft_budget     Float?
  spend           Float    @default(0)
  spend_exact     Decimal? @db.Decimal(38, 18)
  reserved_spend_exact Decimal @default(0) @db.Decimal(38, 18)
  budget_duration String?
  budget_reset_at DateTime?
  models          String[]
  blocked         Boolean  @default(false)
  tpm_limit       Int?
  output_tpm_limit Int?
  rpm_limit       Int?
  rph_limit       Int?
  rpd_limit       Int?
  tpd_limit       Int?
  team_id         String?
  metadata        Json?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  team DeltaLLM_TeamTable?          @relation(fields: [team_id], references: [team_id])
  keys DeltaLLM_VerificationToken[]

  @@index([team_id])
  @@map("deltallm_usertable")
}

model DeltaLLM_TeamTable {
  team_id          String   @id @default(uuid())
  team_alias       String?
  organization_id  String?
  max_budget       Float?
  soft_budget      Float?
  spend            Float    @default(0)
  spend_exact      Decimal? @db.Decimal(38, 18)
  reserved_spend_exact Decimal @default(0) @db.Decimal(38, 18)
  budget_duration  String?
  budget_reset_at  DateTime?
  model_max_budget Json?
  model_rpm_limit  Json?
  model_tpm_limit  Json?
  tpm_limit        Int?
  output_tpm_limit Int?
  model_output_tpm_limit Json?
  rpm_limit        Int?
  rph_limit        Int?
  rpd_limit        Int?
  tpd_limit        Int?
  models           String[]
  blocked          Boolean  @default(false)
  metadata         Json?
  self_service_keys_enabled       Boolean @default(false)
  self_service_max_keys_per_user  Int?
  self_service_budget_ceiling     Float?
  self_service_require_expiry     Boolean @default(false)
  self_service_max_expiry_days    Int?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  members DeltaLLM_UserTable[]
  keys    DeltaLLM_VerificationToken[]
  service_accounts DeltaLLM_ServiceAccount[]
  asset_grants     DeltaLLM_AssetGrant[] @relation("asset_grant_team")

  @@index([organization_id])
  @@map("deltallm_teamtable")
}

model DeltaLLM_ServiceAccount {
  service_account_id    String   @id @default(uuid())
  team_id               String
  name                  String
  description           String?
  is_active             Boolean  @default(true)
  metadata              Json?
  created_by_account_id String?
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  team       DeltaLLM_TeamTable @relation(fields: [team_id], references: [team_id], onDelete: Cascade)
  created_by DeltaLLM_PlatformAccount? @relation("created_service_accounts", fields: [created_by_account_id], references: [account_id], onDelete: SetNull)
  keys       DeltaLLM_VerificationToken[] @relation("verificationtoken_service_account_owner")

  @@unique([team_id, name])
  @@index([team_id])
  @@index([created_by_account_id])
  @@map("deltallm_serviceaccount")
}

model DeltaLLM_OrganizationTable {
  id                String   @id @default(uuid())
  organization_id   String   @unique
  organization_name String?
  audit_content_storage_enabled Boolean @default(false)
  audit_content_policy_version BigInt @default(0)
  max_budget        Float?
  soft_budget       Float?
  rpm_limit         Int?
  tpm_limit         Int?
  output_tpm_limit Int?
  rph_limit         Int?
  rpd_limit         Int?
  tpd_limit         Int?
  model_rpm_limit   Json?
  model_tpm_limit   Json?
  spend             Float    @default(0)
  spend_exact       Decimal? @db.Decimal(38, 18)
  reserved_spend_exact Decimal @default(0) @db.Decimal(38, 18)
  budget_duration   String?
  budget_reset_at   DateTime?
  metadata          Json?
  lifecycle_state               String   @default("active")
  lifecycle_version             BigInt   @default(0)
  deletion_requested_at         DateTime?
  deletion_not_before_at        DateTime?
  deletion_job_id               String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  tier_assignments DeltaLLM_OrganizationTierAssignment[]
  asset_grants     DeltaLLM_AssetGrant[] @relation("asset_grant_organization")
  budget_notification DeltaLLM_BudgetNotification?

  @@index([lifecycle_state, updated_at], map: "deltallm_organizationtable_lifecycle_state_idx")
  @@map("deltallm_organizationtable")
}

model DeltaLLM_OrganizationDeletionJob {
  deletion_job_id         String    @id @default(uuid())
  organization_id         String
  status                  String    @default("pending")
  phase                   String    @default("cancel_pending")
  requested_by_account_id String?
  idempotency_key         String
  request_hash            String
  plan_token              String
  plan_snapshot           Json
  options                 Json      @default("{}")
  progress                Json      @default("{}")
  not_before_at           DateTime
  expedited_at            DateTime?
  expedited_by_account_id String?
  expedite_previous_not_before_at DateTime?
  expedite_idempotency_key String?  @db.VarChar(200)
  expedite_request_hash   String?   @db.Char(64)
  attempt_count           Int       @default(0)
  max_attempts            Int       @default(20)
  next_attempt_at         DateTime  @default(now())
  locked_by               String?
  lease_expires_at        DateTime?
  claim_epoch             BigInt    @default(0)
  last_error_code         String?
  last_error_detail       String?   @db.VarChar(512)
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt
  completed_at            DateTime?
  restored_at             DateTime?

  @@unique([organization_id, idempotency_key], map: "deltallm_orgdeletionjob_org_idempotency_key")
  @@index([status, next_attempt_at], map: "deltallm_orgdeletionjob_due_idx")
  @@index([lease_expires_at], map: "deltallm_orgdeletionjob_lease_idx")
  @@index([organization_id, created_at], map: "deltallm_orgdeletionjob_org_created_idx")
  @@map("deltallm_organizationdeletionjob")
}

model DeltaLLM_OrganizationTombstone {
  organization_id String   @id
  deletion_job_id String   @unique
  deleted_at      DateTime @default(now())

  @@index([deleted_at], map: "deltallm_organizationtombstone_deleted_idx")
  @@map("deltallm_organizationtombstone")
}

model DeltaLLM_TeamTombstone {
  team_id         String   @id
  organization_id String
  deletion_job_id String
  deleted_at      DateTime @default(now())

  @@index([organization_id], map: "deltallm_teamtombstone_org_idx")
  @@index([deletion_job_id], map: "deltallm_teamtombstone_job_idx")
  @@index([deleted_at], map: "deltallm_teamtombstone_deleted_idx")
  @@map("deltallm_teamtombstone")
}

model DeltaLLM_OrganizationPrincipalTombstone {
  principal_id   String
  organization_id String
  deletion_job_id String
  recorded_at    DateTime @default(now())

  @@id([principal_id, organization_id])
  @@index([organization_id], map: "deltallm_orgprincipaltombstone_org_idx")
  @@index([deletion_job_id], map: "deltallm_orgprincipaltombstone_job_idx")
  @@map("deltallm_organizationprincipaltombstone")
}

model DeltaLLM_OrganizationLifecycleGeneration {
  singleton_id Int      @id @default(1) @db.SmallInt
  generation   BigInt   @default(0)
  updated_at   DateTime @updatedAt

  @@map("deltallm_organizationlifecyclegeneration")
}

model DeltaLLM_AuditEvent {
  event_id       String   @id @default(uuid())
  occurred_at    DateTime @default(now())
  organization_id String?
  actor_type     String?
  actor_id       String?
  api_key        String?
  action         String
  resource_type  String?
  resource_id    String?
  request_id     String?
  correlation_id String?
  ip             String?
  user_agent     String?
  status         String?
  latency_ms     Int?
  input_tokens   Int?
  output_tokens  Int?
  error_type     String?
  error_code     String?
  metadata       Json?
  content_stored Boolean  @default(false)
  prev_hash      String?
  event_hash     String?

  payloads DeltaLLM_AuditPayload[]

  @@index([occurred_at])
  @@index([organization_id])
  @@index([actor_id])
  @@index([action])
  @@index([request_id])
  @@index([correlation_id])
  @@index([organization_id, occurred_at], map: "deltallm_auditevent_org_occurred_at_idx")
  @@index([action, occurred_at], map: "deltallm_auditevent_action_occurred_at_idx")
  @@index([status, occurred_at], map: "deltallm_auditevent_status_occurred_at_idx")
  @@map("deltallm_auditevent")
}

model DeltaLLM_AuditPayload {
  payload_id      String   @id @default(uuid())
  event_id        String
  kind            String
  storage_mode    String   @default("inline")
  content_json    Json?
  storage_uri     String?
  content_sha256  String?
  size_bytes      Int?
  redacted        Boolean  @default(false)
  created_at      DateTime @default(now())

  event DeltaLLM_AuditEvent @relation(fields: [event_id], references: [event_id], onDelete: Cascade)

  @@index([event_id])
  @@index([kind])
  @@index([created_at])
  @@map("deltallm_auditpayload")
}

model DeltaLLM_PlatformAccount {
  account_id          String   @id @default(uuid())
  email               String   @unique
  api_namespace       String?
  password_hash       String?
  role                String   @default("org_user")
  is_active           Boolean  @default(true)
  force_password_change Boolean @default(false)
  mfa_enabled         Boolean  @default(false)
  mfa_secret          String?
  mfa_pending_secret  String?
  metadata            Json?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
  last_login_at       DateTime?

  sessions            DeltaLLM_PlatformSession[]
  identities          DeltaLLM_PlatformIdentity[]
  organization_memberships DeltaLLM_OrganizationMembership[]
  team_memberships    DeltaLLM_TeamMembership[]
  owned_keys          DeltaLLM_VerificationToken[] @relation("verificationtoken_account_owner")
  created_service_accounts DeltaLLM_ServiceAccount[] @relation("created_service_accounts")
  created_emails      DeltaLLM_EmailOutbox[] @relation("created_email_messages")
  invitations         DeltaLLM_PlatformInvitation[] @relation("platform_invitation_account")
  sent_invitations    DeltaLLM_PlatformInvitation[] @relation("platform_invitation_inviter")
  email_tokens        DeltaLLM_EmailToken[] @relation("email_token_account")
  created_email_tokens DeltaLLM_EmailToken[] @relation("email_token_creator")
  published_tier_versions DeltaLLM_TierVersion[] @relation("tier_version_publisher")
  created_tier_versions DeltaLLM_TierVersion[] @relation("tier_version_creator")
  owned_managed_assets DeltaLLM_ManagedAsset[] @relation("managed_asset_owner")
  created_managed_assets DeltaLLM_ManagedAsset[] @relation("managed_asset_creator")
  created_asset_grants DeltaLLM_AssetGrant[] @relation("asset_grant_creator")
  authorized_model_credential_bindings DeltaLLM_ModelDeployment[] @relation("model_credential_binding_authorizer")

  @@map("deltallm_platformaccount")
}

model DeltaLLM_PlatformSession {
  session_id          String   @id @default(uuid())
  account_id          String
  session_token_hash  String   @unique
  mfa_verified        Boolean  @default(false)
  expires_at          DateTime
  revoked_at          DateTime?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
  last_seen_at        DateTime @default(now())
  external_mfa_secret_digest String?
  external_parent_id String?
  external_generation Int?
  external_integration_epoch Int?
  external_binding_epoch Int?
  external_subject_epoch Int?

  account DeltaLLM_PlatformAccount @relation(fields: [account_id], references: [account_id], onDelete: Cascade)
  external_parent DeltaLLM_ExternalAuthParentSession? @relation(fields: [external_parent_id], references: [parent_id], onDelete: Restrict)

  @@index([account_id])
  @@index([expires_at])
  @@index([external_parent_id, external_generation])
  @@map("deltallm_platformsession")
}

model DeltaLLM_MasterSession {
  session_id             String   @id @default(uuid())
  token_hash             String   @unique
  master_key_fingerprint String
  expires_at             DateTime
  revoked_at             DateTime?
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt
  last_seen_at           DateTime @default(now())

  @@index([expires_at])
  @@map("deltallm_mastersession")
}

model DeltaLLM_PlatformIdentity {
  identity_id         String   @id @default(uuid())
  account_id          String
  provider            String
  subject             String
  email               String?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  account DeltaLLM_PlatformAccount @relation(fields: [account_id], references: [account_id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([account_id])
  @@map("deltallm_platformidentity")
}

model DeltaLLM_ExternalAuthIntegration {
  integration_id String @id
  enabled Boolean @default(false)
  epoch Int @default(0)
  version Int @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  bindings DeltaLLM_ExternalAuthBinding[]
  assertions DeltaLLM_ExternalAuthAssertionUse[]
  @@map("deltallm_externalauthintegration")
}

model DeltaLLM_ExternalAuthBinding {
  binding_id String @id @default(uuid())
  integration_id String
  external_customer_id String
  organization_id String
  team_id String
  profile String @default("customer_v1")
  state String @default("active")
  epoch Int @default(0)
  version Int @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  integration DeltaLLM_ExternalAuthIntegration @relation(fields: [integration_id], references: [integration_id], onDelete: Restrict)
  subjects DeltaLLM_ExternalAuthSubject[]
  @@unique([integration_id, external_customer_id])
  @@unique([integration_id, binding_id])
  @@index([organization_id])
