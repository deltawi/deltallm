enum DeltaLLM_BatchJobStatus {
  queued
  in_progress
  finalizing
  completed
  failed
  cancelled
  expired
}

model DeltaLLM_BatchJob {
  batch_id                 String   @id @default(uuid())
  endpoint                 String
  status                   DeltaLLM_BatchJobStatus
  execution_mode           String   @default("managed_internal")
  input_file_id            String
  output_file_id           String?
  error_file_id            String?
  model                    String?
  metadata                 Json?
  provider_batch_id        String?
  provider_status          String?
  provider_error           String?
  provider_last_sync_at    DateTime?
  total_items              Int      @default(0)
  in_progress_items        Int      @default(0)
  completed_items          Int      @default(0)
  failed_items             Int      @default(0)
  cancelled_items          Int      @default(0)
  locked_by                String?
  lease_expires_at         DateTime?
  cancel_requested_at      DateTime?
  status_last_updated_at   DateTime @default(now())
  scheduler_version        String?
  scheduling_model         String?
  scheduling_model_group   String?
  scheduling_endpoint      String?
  tenant_scope_type        String?
  tenant_scope_id          String?
  service_tier             String   @default("standard")
  estimated_work_units     Int      @default(0)
  remaining_work_units     Int      @default(0)
  size_class               String   @default("xs")
  queue_entered_at         DateTime?
  first_claimed_at         DateTime?
  last_claimed_at          DateTime?
  last_scheduled_at        DateTime?
  scheduler_debug          Json?
  webhook_config_ciphertext String?
  webhook_config_fingerprint String?
  created_by_api_key       String?
  created_by_user_id       String?
  created_by_team_id       String?
  created_by_organization_id String?
  created_by_owner_account_id String?
  created_by_owner_snapshot_complete Boolean @default(false)
  created_at               DateTime @default(now())
  started_at               DateTime?
  completed_at             DateTime?
  expires_at               DateTime?

  input_file DeltaLLM_BatchFile  @relation("BatchInputFile", fields: [input_file_id], references: [file_id])
  output_file DeltaLLM_BatchFile? @relation("BatchOutputFile", fields: [output_file_id], references: [file_id])
  error_file DeltaLLM_BatchFile? @relation("BatchErrorFile", fields: [error_file_id], references: [file_id])
  items DeltaLLM_BatchItem[]

  @@index([status, created_at])
  @@index([lease_expires_at])
  @@index([created_by_api_key, created_at])
  @@index([created_by_user_id, created_at], map: "deltallm_batch_job_user_created_idx")
  @@index([created_by_team_id, created_at])
  @@index([created_by_organization_id, created_at])
  @@index([status, scheduling_model_group, service_tier, queue_entered_at], map: "deltallm_batch_job_sched_model_status_idx")
  @@index([status, tenant_scope_type, tenant_scope_id, queue_entered_at], map: "deltallm_batch_job_sched_tenant_status_idx")
  @@index([status, size_class, queue_entered_at], map: "deltallm_batch_job_sched_size_status_idx")
  @@index([status, last_scheduled_at, created_at], map: "deltallm_batch_job_work_slice_claim_idx")
  @@index([expires_at])
  @@map("deltallm_batch_job")
}

model DeltaLLM_BatchItem {
  item_id            String   @id @default(uuid())
  batch_id           String
  line_number        Int
  custom_id          String
  status             String
  request_body       Json
  selector_checkpoint Json?
  accounting_checkpoint Json?
  response_body      Json?
  error_body         Json?
  usage              Json?
  provider_cost      Float    @default(0)
  billed_cost        Float    @default(0)
  attempts           Int      @default(0)
  claim_epoch        BigInt   @default(0)
  last_error         String?
  locked_by          String?
  lease_expires_at   DateTime?
  scheduling_model   String?
  scheduling_model_group String?
  estimated_work_units Int      @default(1)
  not_before_at      DateTime?
  last_scheduled_at  DateTime?
  created_at         DateTime @default(now())
  started_at         DateTime?
  completed_at       DateTime?

  batch DeltaLLM_BatchJob @relation(fields: [batch_id], references: [batch_id])

  @@unique([batch_id, line_number])
  @@unique([batch_id, custom_id])
  @@index([batch_id, status])
  @@index([batch_id, status, not_before_at, line_number], map: "deltallm_batch_item_sched_batch_status_idx")
  @@index([scheduling_model_group, status, not_before_at], map: "deltallm_batch_item_sched_model_status_idx")
  @@index([lease_expires_at])
  @@map("deltallm_batch_item")
}

